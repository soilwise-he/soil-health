    <!-- https://soilwise-he.github.io/soil-health#AcidPrecipitation -->


    <NamedIndividual rdf:about="https://soilwise-he.github.io/soil-health#AcidPrecipitation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
