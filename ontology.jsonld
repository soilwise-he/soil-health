}, {
  "@id" : "https://soilwise-he.github.io/soil-health#ConversionFactor1724",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://aims.fao.org/aos/agrontology#valueUsedIn" : [ {
    "@id" : "https://soilwise-he.github.io/soil-health#SOCToSOMConversion"
  } ],
  "http://qudt.org/schema/qudt/numericValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#float",
    "@value" : "1.724"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/QuantityValue"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Historically, a factor of 1.724 has been used to convert SOC to SOM, based on the assumption that organic matter is 58% carbon."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "conversion factor 1.724"
  } ]
}, {
  "@id" : "https://soilwise-he.github.io/soil-health#ConversionFactor2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://aims.fao.org/aos/agrontology#valueUsedIn" : [ {
    "@id" : "https://soilwise-he.github.io/soil-health#SOCToSOMConversion"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://soilwise-he.github.io/soil-health#Pribyl2010"
  } ],
  "http://qudt.org/schema/qudt/numericValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#int",
    "@value" : "2"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://qudt.org/schema/qudt/QuantityValue"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A factor of 2 would often be more accurate, especially in the case of soil layers rich in organic matter, such as on forest floors, because of differences related to the different stages of decomposition and mineralisation."
  } ],
