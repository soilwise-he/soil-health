        <skos:narrower rdf:resource="https://soilwise-he.github.io/soil-health#SOCLosses"/>
        <skos:prefLabel xml:lang="en">soil threats</skos:prefLabel>
        <soil-health:indicates rdf:resource="https://soilwise-he.github.io/soil-health#SoilDegradation"/>
        <soil-health:isIndicatedBy rdf:resource="https://soilwise-he.github.io/soil-health#SoilErosion"/>
