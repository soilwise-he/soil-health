    <!-- https://soilwise-he.github.io/soil-health#SoilHealth -->


    <NamedIndividual rdf:about="https://soilwise-he.github.io/soil-health#SoilHealth">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <agrontology:isBeneficialFor rdf:resource="https://soilwise-he.github.io/soil-health#AnimalHealth"/>
        <agrontology:isBeneficialFor rdf:resource="https://soilwise-he.github.io/soil-health#BiologicalProductivity"/>
        <agrontology:isBeneficialFor rdf:resource="https://soilwise-he.github.io/soil-health#EnvironmentalQuality"/>
        <agrontology:isBeneficialFor rdf:resource="https://soilwise-he.github.io/soil-health#HumanHealth"/>
        <agrontology:isBeneficialFor rdf:resource="https://soilwise-he.github.io/soil-health#PlantHealth"/>
        <agrontology:isBeneficialFor rdf:resource="https://soilwise-he.github.io/soil-health#Productivity"/>
        <obo:T4FS_0000577 rdf:resource="https://soilwise-he.github.io/soil-health#LowestSOCContentThresholds"/>
        <terms:source rdf:resource="https://soilwise-he.github.io/soil-health#Bonfante2020"/>
        <terms:source rdf:resource="https://soilwise-he.github.io/soil-health#Bunemann2018"/>
        <terms:source rdf:resource="https://soilwise-he.github.io/soil-health#Vogel2020"/>
        <skos:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_a9645d28"/>
        <skos:definition xml:lang="en">Soil health is defined as the actual capacity of a soil to perform its core functions and to provide ecosystem services.</skos:definition>
        <skos:definition xml:lang="en">The definition of soil health is the capacity of a soil to function within ecosystems and land-use boundaries to sustain biological productivity, maintain environmental quality, and promote plant and animal health.</skos:definition>
        <skos:prefLabel xml:lang="en">soil health</skos:prefLabel>
    </NamedIndividual>
    


