    "@id" : "http://aims.fao.org/aos/agrovoc/c_a9645d28"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Soil health is defined as the actual capacity of a soil to perform its core functions and to provide ecosystem services."
  }, {
    "@language" : "en",
    "@value" : "The definition of soil health is the capacity of a soil to function within ecosystems and land-use boundaries to sustain biological productivity, maintain environmental quality, and promote plant and animal health."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
